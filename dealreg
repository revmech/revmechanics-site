<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Register a Deal | Revenue Mechanics</title>
  <meta name="description" content="Register a deal with Revenue Mechanics.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="../RevMechanics-Light-Icon.png">
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
  <script>
    function timestamp() {
      var response = document.getElementById("g-recaptcha-response");
      if (response == null || response.value.trim() == "") {
        var elems = JSON.parse(document.getElementsByName("captcha_settings")[0].value);
        elems["ts"] = JSON.stringify(new Date().getTime());
        document.getElementsByName("captcha_settings")[0].value = JSON.stringify(elems);
      }
    }
    setInterval(timestamp, 500);
  </script>
  <style>
    :root {
      --bg: #07110d;
      --panel: rgba(255,255,255,0.045);
      --line: rgba(255,255,255,0.09);
      --text: #f4f7f5;
      --muted: #a8b6ae;
      --glow: rgba(137,184,156,0.10);
      --glow-2: rgba(95,143,116,0.08);
    }

    * { box-sizing: border-box; }

    html, body { margin: 0; min-height: 100%; }

    body {
      font-family: "Manrope", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--text);
      background:
        radial-gradient(900px 500px at 12% 8%, var(--glow), transparent 55%),
        radial-gradient(700px 420px at 88% 12%, var(--glow-2), transparent 50%),
        linear-gradient(180deg, #07110d 0%, #09130f 100%);
    }

    .wrap {
      max-width: 1120px;
      margin: 0 auto;
      padding: 40px 24px 64px;
    }

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .site-logo {
      display: block;
      width: min(280px, 58vw);
      height: auto;
    }

    .back-link {
      color: #b5c4bb;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
    }

    .back-link:hover { color: var(--text); }

    .registration-layout {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 48px;
      align-items: start;
      padding-top: 86px;
    }

    .eyebrow {
      display: inline-block;
      margin-bottom: 18px;
      padding: 8px 12px;
      border: 1px solid rgba(137,184,156,0.16);
      border-radius: 999px;
      background: rgba(137,184,156,0.06);
      color: #d9e4dd;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-size: 62px;
      line-height: 0.98;
      letter-spacing: -0.05em;
      font-weight: 600;
    }

    .gradient {
      background: linear-gradient(90deg, #f4f7f5 0%, #b7cec0 52%, #7da890 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .intro-copy {
      max-width: 460px;
      margin: 24px 0 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.65;
    }

    .intro-note {
      max-width: 430px;
      margin: 34px 0 0;
      padding-top: 18px;
      border-top: 1px solid var(--line);
      color: #d5ddd8;
      font-size: 14px;
      line-height: 1.6;
    }

    .panel {
      border: 1px solid var(--line);
      border-radius: 24px;
      padding: 30px;
      background: linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.025));
      backdrop-filter: blur(12px);
      box-shadow:
        0 18px 50px rgba(0,0,0,0.22),
        inset 0 1px 0 rgba(255,255,255,0.04);
    }

    .panel-title {
      margin: 0 0 8px;
      font-size: 12px;
      color: #d5ddd8;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .panel-intro {
      margin: 0 0 24px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.55;
    }

    .registration-form {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 16px;
    }

    .field,
    .captcha-field,
    .form-actions { min-width: 0; }

    .field-wide,
    .captcha-field,
    .form-actions { grid-column: 1 / -1; }

    label {
      display: block;
      margin-bottom: 7px;
      color: #e4ebe7;
      font-size: 13px;
      font-weight: 600;
    }

    input[type="text"],
    input[type="email"],
    textarea {
      display: block;
      width: 100%;
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 10px;
      padding: 12px 13px;
      color: var(--text);
      background: rgba(0,0,0,0.18);
      font: inherit;
      font-size: 14px;
      outline: none;
      transition: border-color 120ms ease, box-shadow 120ms ease;
    }

    textarea {
      min-height: 118px;
      resize: vertical;
    }

    input[type="text"]:focus,
    input[type="email"]:focus,
    textarea:focus {
      border-color: #9dbda9;
      box-shadow: 0 0 0 3px rgba(157,189,169,0.14);
    }

    .captcha-field { padding-top: 2px; }

    .captcha-label {
      margin-bottom: 10px;
    }

    .captcha-note {
      min-height: 20px;
      margin: 10px 0 0;
      color: #e8b7a7;
      font-size: 13px;
    }

    .form-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding-top: 4px;
    }

    .required-note {
      margin: 0;
      color: #8fa098;
      font-size: 12px;
      line-height: 1.4;
    }

    .submit-button {
      border: 0;
      border-radius: 14px;
      padding: 14px 18px;
      color: #09110d;
      background: linear-gradient(135deg, #9dbda9 0%, #73967d 100%);
      box-shadow: 0 12px 28px rgba(0,0,0,0.22);
      cursor: pointer;
      font: inherit;
      font-size: 15px;
      font-weight: 700;
      transition: transform 120ms ease;
    }

    .submit-button:hover { transform: translateY(-1px); }

    .footer {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding-top: 42px;
      color: #8fa098;
      font-size: 14px;
    }

    @media (max-width: 920px) {
      .registration-layout {
        grid-template-columns: 1fr;
        gap: 42px;
        padding-top: 72px;
      }

      h1 { font-size: 50px; }
    }

    @media (max-width: 560px) {
      .wrap { padding: 28px 18px 42px; }

      .site-header { align-items: flex-start; }

      .back-link { padding-top: 8px; }

      .registration-form { grid-template-columns: 1fr; }

      .field-wide,
      .captcha-field,
      .form-actions { grid-column: auto; }

      .panel { padding: 22px; }

      .form-actions {
        align-items: flex-start;
        flex-direction: column;
      }

      .submit-button { width: 100%; }

      .footer { flex-direction: column; padding-top: 32px; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header class="site-header">
      <a href="../" aria-label="Revenue Mechanics home">
        <img
          class="site-logo"
          src="../RevMechanics-Dark-Horizontal.png"
          alt="Revenue Mechanics"
        >
      </a>
      <a class="back-link" href="../">Back to home</a>
    </header>

    <main class="registration-layout">
      <section>
        <div class="eyebrow">Partner Program</div>
        <h1>Register a <span class="gradient">deal</span>.</h1>
        <p class="intro-copy">
          Have an opportunity that could benefit from Revenue Mechanics? Share a few details and we’ll follow up with next steps.
        </p>
        <p class="intro-note">
          Submit one form per opportunity. Please include enough context for our team to understand the customer, timing, and the help you’re looking for.
        </p>
      </section>

      <section class="panel" aria-labelledby="form-title">
        <p class="panel-title" id="form-title">Deal Registration</p>
        <p class="panel-intro">Tell us who you are and a little about the opportunity.</p>

        <form
          class="registration-form"
          action="https://webto.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8&amp;orgId=00Da500001Vi89C"
          method="POST"
        >
          <input type="hidden" name="captcha_settings" value='{"keyname":"RevMechs","fallback":"true","orgId":"00Da500001Vi89C","ts":""}'>
          <input type="hidden" name="oid" value="00Da500001Vi89C">
          <input type="hidden" name="retURL" value="https://www.revmechanics.io/dealreg">

          <div class="field">
            <label for="first_name">First Name</label>
            <input id="first_name" maxlength="40" name="first_name" type="text" autocomplete="given-name" required>
          </div>

          <div class="field">
            <label for="last_name">Last Name</label>
            <input id="last_name" maxlength="80" name="last_name" type="text" autocomplete="family-name" required>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input id="email" maxlength="80" name="email" type="email" autocomplete="email" required>
          </div>

          <div class="field">
            <label for="company">Company</label>
            <input id="company" maxlength="40" name="company" type="text" autocomplete="organization" required>
          </div>

          <div class="field">
            <label for="city">City</label>
            <input id="city" maxlength="40" name="city" type="text" autocomplete="address-level2">
          </div>

          <div class="field">
            <label for="state">State / Province</label>
            <input id="state" maxlength="20" name="state" type="text" autocomplete="address-level1">
          </div>

          <div class="field field-wide">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="5" placeholder="Share the customer, opportunity, timing, and what you need from us."></textarea>
          </div>

          <input type="hidden" id="lead_source" name="lead_source" value="Web">

          <div class="captcha-field">
            <label class="captcha-label">Security check</label>
            <div class="g-recaptcha" data-sitekey="6LdIKLYtAAAAAPp7q5HcswRKvQRAq-Y2tjEpiRBl"></div>
            <p class="captcha-note" id="captcha-message" aria-live="polite"></p>
          </div>

          <div class="form-actions">
            <p class="required-note">Required fields are marked by your browser.</p>
            <input class="submit-button" type="submit" name="submit" value="Submit Deal Registration">
          </div>
        </form>
      </section>
    </main>

    <footer class="footer">
      <div>Revenue Mechanics</div>
      <div>Salesforce · RevOps · GTM Systems</div>
    </footer>
  </div>

  <script>
    document.querySelector(".registration-form").addEventListener("submit", function (event) {
      var response = document.getElementById("g-recaptcha-response");
      var message = document.getElementById("captcha-message");

      if (response == null || response.value.trim() == "") {
        event.preventDefault();
        message.textContent = "Please complete the security check before submitting.";
      } else {
        message.textContent = "";
      }
    });
  </script>
</body>
</html>
